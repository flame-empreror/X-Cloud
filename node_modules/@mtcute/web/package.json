{
    "name": "@mtcute/web",
    "type": "module",
    "version": "0.32.1",
    "description": "Meta-package for the web platform",
    "license": "MIT",
    "dependencies": {
        "@mtcute/core": "^0.32.1",
        "@mtcute/wasm": "^0.32.0",
        "@fuman/net": "0.0.21",
        "@fuman/utils": "0.0.21"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./index.d.ts",
                "default": "./index.js"
            },
            "require": {
                "types": "./index.d.cts",
                "default": "./index.cjs"
            }
        },
        "./utils.js": {
            "import": {
                "types": "./utils.d.ts",
                "default": "./utils.js"
            },
            "require": {
                "types": "./utils.d.cts",
                "default": "./utils.cjs"
            }
        },
        "./methods.js": {
            "import": {
                "types": "./methods.d.ts",
                "default": "./methods.js"
            },
            "require": {
                "types": "./methods.d.cts",
                "default": "./methods.cjs"
            }
        }
    },
    "author": "alina sireneva <alina@tei.su>",
    "sideEffects": false,
    "denoJson": {
        "compilerOptions": {
            "lib": [
                "dom",
                "dom.iterable",
                "deno.ns",
                "WebWorker"
            ]
        }
    },
    "homepage": "https://mtcute.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mtcute/mtcute.git"
    },
    "scripts": {}
}